{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SessionBridge",
  "version": "0.1.0",
  "identifier": "dev.sessionbridge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SessionBridge",
        "width": 1380,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "DeveloperTool",
    "shortDescription": "Coordinate autonomous coding agents",
    "longDescription": "A local-first operator console for coordinating autonomous coding agents."
  }
}
